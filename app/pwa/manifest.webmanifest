{
  "id": "/rainform-ultimate/",
  "name": "Rainform Ultimate · 如果降雨数据变成雨",
  "short_name": "Rainform",
  "description": "把逐时降雨数据变成一场可以走进去的 3D 雨；支持接入实时天气数据源。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "fullscreen"],
  "orientation": "any",
  "background_color": "#03070d",
  "theme_color": "#03070d",
  "categories": ["weather", "entertainment", "utilities", "education"],
  "icons": [
    { "src": "icons/icon-64.png", "sizes": "64x64", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "实时天气",
      "short_name": "实时",
      "description": "打开实时天气数据源面板",
      "url": "./index.html?panel=weather",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "壁纸模式",
      "short_name": "壁纸",
      "description": "隐藏所有面板，纯净雨景",
      "url": "./index.html?wallpaper=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
