{
  "name": "rainform-ultimate-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Rainform Ultimate — Capacitor shell for Android and iOS",
  "scripts": {
    "web": "node ../../build-apps.js",
    "sync": "cap sync",
    "update": "node ../../build-apps.js && cap sync",
    "add:android": "cap add android && node scripts/patch-android.js",
    "add:ios": "cap add ios && node scripts/patch-ios.js",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "build:android": "cap build android",
    "build:ios": "cap build ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}
