<?xml version="1.0" encoding="utf-8"?>
<!-- Rainform talks to user-configured weather gateways, which are often plain
     HTTP on a LAN address (e.g. http://192.168.1.7:8787). Android 9+ blocks
     cleartext by default, so it is explicitly allowed here. The app itself
     serves its UI over 127.0.0.1, which also needs this. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
